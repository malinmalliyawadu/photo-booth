# The controller's front door. Caddy terminates TLS with the certificate
# from ops/ca.sh and gives every screen one origin: the booth app, the
# media it serves, and (from phase 3) the worker's MJPEG preview.
#
# `next start` cannot serve TLS, and Safari will not load an http
# preview stream into an https page, so one proxy in front of both is
# the simplest shape that works.
#
#   caddy run --config ops/Caddyfile
#
# Phase 6 wraps this in a systemd unit next to the app and the worker.

https://booth.local, https://localhost {
	tls /opt/photo-booth/ops/certs/booth.crt /opt/photo-booth/ops/certs/booth.key

	# The live preview, phase 3. The worker streams MJPEG on 3101.
	handle /preview/* {
		reverse_proxy localhost:3101 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy localhost:3100 {
			# Server-Sent Events must not be buffered.
			flush_interval -1
		}
	}

	encode zstd gzip
	log {
		output file /var/log/caddy/booth.log
	}
}

# The CA certificate over plain HTTP, so a phone or the iPad can fetch
# it before it trusts anything.
http://booth.local, http://localhost {
	handle /ca.crt {
		root * /opt/photo-booth/ops/certs
		file_server
		header Content-Type application/x-x509-ca-cert
	}
	redir / https://{host}{uri} permanent
}
