# The app and worker images build from the repository root (their
# Dockerfiles live beside them). Keep installs, builds, runtime data and
# secrets out of the context.
.git
.claude
node_modules
**/node_modules
**/.next
**/out
**/*.tsbuildinfo
.env
.env.*
!.env.example
data
ops/certs
e2e/test-results
e2e/playwright-report
