# Postgres for the booth app and the worker. docker-compose exposes the
# local one on 5436 so it does not clash with other projects' databases.
DATABASE_URL=postgres://booth:booth@localhost:5436/booth

# Where originals, composites and uploaded templates live. Relative paths
# resolve from the repo root. On the controller this is a directory on
# the SSD that the night-of checklist copies to two places.
BOOTH_DATA_DIR=./data

# The attendant's way into /admin from their phone. Anybody on the booth
# Wi-Fi can reach the controller, and admin can delete sessions and see
# every photo, so this is not optional. Generate one with:
#   openssl rand -base64 18
ADMIN_PASSWORD=change-me

# Which camera the worker drives: fake (sample photos, no hardware),
# gphoto2 (phase 3) or ipad (the kiosk captures through getUserMedia).
# Only the initial value; the admin page can switch at runtime.
BOOTH_CAMERA=fake

# Which printer the worker drives: fake (marks jobs done) or cups (phase 4).
BOOTH_PRINTER=fake

# The origin that goes into the QR code. Phase 5 points this at the
# gallery on Coolify; until then it is the booth itself.
GALLERY_ORIGIN=https://localhost:3100
