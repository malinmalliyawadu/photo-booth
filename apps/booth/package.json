{
  "name": "@booth/booth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --silent certs && next dev -p 3100 --experimental-https --experimental-https-key ../../ops/certs/booth.key --experimental-https-cert ../../ops/certs/booth.crt --experimental-https-ca ../../ops/certs/ca.crt",
    "certs": "test -f ../../ops/certs/booth.crt || ../../ops/ca.sh",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint",
    "dev:http": "next dev -p 3100"
  },
  "dependencies": {
    "@booth/core": "workspace:*",
    "@booth/db": "workspace:*",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
