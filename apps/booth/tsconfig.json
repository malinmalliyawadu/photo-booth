{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // Next writes both type directories into "include" so one tsconfig
  // serves dev and build, but only its in-process checker skips
  // .next/dev/types; the tsc CLI that `next build` and `pnpm typecheck`
  // run checks everything listed, and a validator left by an earlier
  // `next dev` still imports routes that have since moved. Exclude it:
  // .next/types is regenerated by `next typegen` and `next build`.
  "exclude": ["node_modules", ".next/dev/types"]
}
